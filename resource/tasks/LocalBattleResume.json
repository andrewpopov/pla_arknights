    "LocalBattleDismissPausedSelection": {
        "algorithm": "OcrDetect",
        "text": ["PAUSED"],
        "roi": [430, 250, 420, 190],
        "fullMatch": true,
        "cache": false,
        "action": "ClickRect",
        "specificRect": [630, 0, 20, 20],
        "postDelay": 200,
