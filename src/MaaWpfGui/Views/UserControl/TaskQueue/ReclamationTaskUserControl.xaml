<UserControl
    x:Class="MaaWpfGui.Views.UserControl.TaskQueue.ReclamationTaskUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:CalcBinding;assembly=CalcBinding"
    xmlns:controls="clr-namespace:MaaWpfGui.Styles.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:s="https://github.com/canton7/Stylet"
    xmlns:taskQueue_vms="clr-namespace:MaaWpfGui.ViewModels.UserControl.TaskQueue"
    d:DataContext="{d:DesignInstance {x:Type taskQueue_vms:ReclamationTaskUserControlModel}}"
    d:DesignWidth="220"
    s:View.ActionTarget="{Binding}"
    mc:Ignorable="d">
    <StackPanel>
        <controls:TextBlock Text="{DynamicResource Toolbox.MiniGame.Reclamation.Theme.Tales}" TextWrapping="Wrap" />
        <ComboBox
            Margin="0,10"
            DisplayMemberPath="Display"
            ItemsSource="{Binding Modes}"
            SelectedValue="{Binding Mode}"
            SelectedValuePath="Value" />
        <controls:TextBlock
            Margin="0,0,0,10"
            Text="{Binding Description}"
            TextWrapping="Wrap" />
        <StackPanel Visibility="{c:Binding ShowCraftSettings}">
            <TextBox
                Margin="0,10"
                hc:TitleElement.Title="{DynamicResource Toolbox.MiniGame.Reclamation.ToolToCraft.Tip}"
                Text="{Binding ToolToCraft, UpdateSourceTrigger=PropertyChanged}" />
            <hc:NumericUpDown
                Margin="0,10"
                hc:TitleElement.Title="{DynamicResource Toolbox.MiniGame.Reclamation.MaxCraftCountPerRound}"
                Maximum="99"
                Minimum="1"
                Value="{Binding MaxCraftCountPerRound}" />
            <CheckBox IsChecked="{Binding ClearStore}">
                <controls:TextBlock Text="{DynamicResource Toolbox.MiniGame.Reclamation.ClearStore}" TextWrapping="Wrap" />
            </CheckBox>
        </StackPanel>
    </StackPanel>
</UserControl>
